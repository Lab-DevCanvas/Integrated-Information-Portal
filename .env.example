# Next.js server -> crawling FastAPI. Browser requests use /api/crawling.
CRAWLING_API_URL=http://localhost:8000

# Server-only AI backend. Vercel requires HTTPS URL and token.
# Local development without a token can use an SSH tunnel.
# Local SSH tunnel to the RAG VM:
RAG_API_URL=http://127.0.0.1:18001
# Set only in server environment; never use a NEXT_PUBLIC_ prefix.
RAG_API_TOKEN=
